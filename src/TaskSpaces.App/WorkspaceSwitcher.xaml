<Window x:Class="TaskSpaces.App.WorkspaceSwitcher"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TaskSpaces switcher"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        ShowActivated="False" ShowInTaskbar="False">
    <!-- The Alt+Tab-style workspace picker (Petre: "maybe an alt-tab like shortcut for me
         to switch through workspaces"). Shown while Ctrl+Alt is held, hidden on release.

         ShowActivated="False" is essential rather than cosmetic: this window appears WHILE
         Ctrl+Alt are physically down, and taking focus at that moment would hand the
         foreground app a stray modifier state and make our own window the thing the user is
         "in" when they are only pointing at a destination. It never takes focus, never takes
         input, and is not clickable; the keyboard gesture is the only way to drive it.

         Same borderless + AllowsTransparency setup as FloatingBar, and set in XAML for the
         same reason: WPF throws if these are assigned imperatively in the wrong order. -->
    <Border CornerRadius="10" Background="#E6202020" Padding="9,8,9,8">
        <StackPanel>
            <!-- Names the chord actually in force, filled in by Present(): the shortcut is
                 configurable (Petre: "i want it configurable"), so a hardcoded "hold
                 Ctrl+Alt" would start lying the moment anyone changed it.

                 MaxWidth + Wrap because this line, not the workspace names, used to set how wide
                 the whole picker was (Petre: "that list beside the bar, i think it's too wide").
                 The window is SizeToContent, so the longest single line wins, and a sentence of
                 instructions beat every name in the list. Bounded here, it wraps instead of
                 stretching, and the width comes from the thing the picker is actually for. -->
            <TextBlock x:Name="Hint" FontSize="10" Foreground="White" Opacity="0.45"
                       TextWrapping="Wrap" MaxWidth="150" Margin="3,0,3,7"/>
            <!-- One row per workspace, most recently used first. Built in code-behind, like
                 every other list in this app, so the rows can carry the workspace's own
                 lane colour from WorkspacePalette. -->
            <StackPanel x:Name="Rows"/>
        </StackPanel>
    </Border>
</Window>
