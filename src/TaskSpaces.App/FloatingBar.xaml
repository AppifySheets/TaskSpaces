<Window x:Class="TaskSpaces.App.FloatingBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TaskSpaces"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        PreviewMouseLeftButtonDown="OnPreviewMouseLeftButtonDown"
        PreviewMouseMove="OnPreviewMouseMove"
        PreviewMouseLeftButtonUp="OnPreviewMouseLeftButtonUp"
        PreviewMouseDown="OnPreviewMouseDown"
        PreviewMouseUp="OnPreviewMouseUp"
        SizeChanged="OnSizeChanged">
    <!-- Task 11 (spec: Floating icon bar): translucent, borderless, icon-only bar.
         AllowsTransparency requires WindowStyle=None; both set here in XAML (not
         code-behind) to dodge the "AllowsTransparency must be set before the window is
         shown, and WindowStyle must already be None" ordering exception WPF throws when
         these are set imperatively in the wrong order. -->
    <!-- Task 11 fix round 3 (reviewer, Petre: "can't drag it"): dragging is wired at
         the WINDOW level (Preview* handlers above, tunnelling from the root through
         every icon Button) rather than on this Border alone: the bar's surface is
         nearly all icon Buttons with only 6px of Padding as bare background, leaving
         almost nothing to grab. See FloatingBar.xaml.cs for the press/move/threshold
         logic; this Border no longer has its own MouseLeftButtonDown handler. -->
    <!-- Padding 6 -> 4 (Petre: "the padding and the spacing between icons could be reduced a
         little bit so that this whole thing is taking up less space"). Density is a separate
         axis from BarScale: the scale shrinks everything in proportion, while this makes the
         layout tighter at any scale. Not taken to zero, because the bar's bare background is
         what you grab to drag it, and at 0 the only draggable surface left would be the gaps
         between rows. -->
    <Border x:Name="Root" CornerRadius="8" Background="#99202020" Padding="4">
        <!-- No "Hide floating bar" menu any more. Petre: "show floating bar doesn't make
             sense anymore, it's crucial for the app's design." Once the switcher panel and the
             Windows tab were gone this bar became the only surface that lists windows and
             jumps to them, so hiding it left no way to reach your own windows. Always on. -->
        <StackPanel>
            <!-- The bar's two commands, at the TOP. Petre: "those buttons for minimize and switch to
                 previous workspace would make more sense at the top, next to the pin icon. eliminate
                 that bottom row with titles completely."
                 Right-aligned so they sit directly above the name gutter, which is where the pin icon
                 is: every row puts its label in a fixed 58 DIP gutter on the RIGHT, so "next to the
                 pin" and "right-hand end" are the same place on this bar.
                 In their own strip rather than inside the pinned row, and that is the constraint
                 rather than a preference: every row is laid out over one shared set of column
                 definitions so a screen's region lands at the same x on each of them, and a control
                 added inside that grid moves the monitor hairlines. That is #70, #99 and #103, and
                 each was argued from a screenshot.
                 The 18px each costs is paid in WIDTH, on a line that holds nothing else, so the rows
                 below are untouched, and the bar is now SHORTER than before, because the strip this
                 replaces sat under a separator and a reserved text line. -->
            <!-- The 4 DIP gap is not cosmetic, and a pixel test is what found it: RowRingPixelTests
                 samples a 6px band from one pixel ABOVE each row's top edge, and with the buttons
                 flush against the first row the glyphs' bottoms landed in the pinned row's band and
                 read as ring ink on a row that wears none. A gap wider than the band fixes the
                 measurement and the look at once.
                 No separator LINE under it, unlike the strip this replaces: a line spanning the bar's
                 width would put far more ink in that same band, and the point of the change was fewer
                 pixels rather than the same pixels somewhere else. -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,4">
                <Button x:Name="BackButton" Content="↩" Width="18" FontSize="12"
                        Foreground="White" Background="Transparent" BorderThickness="0"
                        Padding="0" VerticalAlignment="Center" Click="OnBackClick"/>
                <Button x:Name="MinimizeButton" Content="▁" Width="18" FontSize="12"
                        Foreground="White" Background="Transparent" BorderThickness="0"
                        Padding="0" VerticalAlignment="Center" Click="OnMinimizeClick"
                        ToolTip="Minimize the bar to a taskbar button"/>
            </StackPanel>

            <!-- One horizontal row per group (Pinned first, then every workspace, then
                 unbound desktops with windows), populated in code-behind (Rebuild). -->
            <StackPanel x:Name="Rows"/>

        </StackPanel>
    </Border>
</Window>
