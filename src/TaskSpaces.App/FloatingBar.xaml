<Window x:Class="TaskSpaces.App.FloatingBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TaskSpaces"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        PreviewMouseLeftButtonDown="OnPreviewMouseLeftButtonDown"
        PreviewMouseMove="OnPreviewMouseMove"
        PreviewMouseLeftButtonUp="OnPreviewMouseLeftButtonUp"
        SizeChanged="OnSizeChanged">
    <!-- Task 11 (spec: Floating icon bar): translucent, borderless, icon-only bar.
         AllowsTransparency requires WindowStyle=None; both set here in XAML (not
         code-behind) to dodge the "AllowsTransparency must be set before the window is
         shown, and WindowStyle must already be None" ordering exception WPF throws when
         these are set imperatively in the wrong order. -->
    <!-- Task 11 fix round 3 (reviewer, Petre: "can't drag it"): dragging is wired at
         the WINDOW level (Preview* handlers above, tunnelling from the root through
         every icon Button) rather than on this Border alone: the bar's surface is
         nearly all icon Buttons with only 6px of Padding as bare background, leaving
         almost nothing to grab. See FloatingBar.xaml.cs for the press/move/threshold
         logic; this Border no longer has its own MouseLeftButtonDown handler. -->
    <Border x:Name="Root" CornerRadius="8" Background="#99202020" Padding="6">
        <!-- No "Hide floating bar" menu any more. Petre: "show floating bar doesn't make
             sense anymore, it's crucial for the app's design." Once the switcher panel and the
             Windows tab were gone this bar became the only surface that lists windows and
             jumps to them, so hiding it left no way to reach your own windows. Always on. -->
        <StackPanel>
            <!-- One horizontal row per group (Pinned first, then every workspace, then
                 unbound desktops with windows), populated in code-behind (Rebuild). -->
            <StackPanel x:Name="Rows"/>

            <!-- Hover info line (Petre: "add a small panel, when i hover over any icon,
                 i want to see what it is"). Deliberately part of THIS window rather than
                 a Popup or ToolTip: those live in their own HWNDs, and this window is a
                 topmost + AllowsTransparency layered window pinned to all virtual
                 desktops, the class of setup where separate-HWND popups are most prone
                 to landing behind the bar or on the wrong desktop. In-window text cannot
                 have that problem.
                 Height is RESERVED (the line is always present, showing a hint when
                 nothing is hovered) instead of appearing on demand: the bar's default
                 position is the bottom-right corner, where a grow-on-hover panel would
                 expand straight off the bottom of the work area. A fixed Width on the
                 text keeps SizeToContent from re-sizing (and thus re-positioning) the
                 whole bar every time a longer or shorter title is hovered. -->
            <Border Height="1" Margin="0,4,0,3" Background="White" Opacity="0.2"/>
            <!-- Petre: "that floating window width can be half of what it is now... maybe even
                 less, 3 icons wide by default, can grow on demand."
                 This TextBlock is what dictated the bar's width: at 340 it was wider than any
                 row of icons, so the bar was always that wide no matter how little was in it.
                 Narrowed to roughly three icons plus a row label. A FIXED width is still the
                 point (see the comment above): it stops a hover from resizing, and therefore
                 repositioning, a SizeToContent window. Rows wider than this still grow the bar,
                 which is the "grow on demand" half. -->
            <!-- Petre: "on the floating window i want a go back to previous button... basically
                 the same as ctrl+win+tab tap once, without the kb."
                 Shares the info line's row rather than taking a row of its own: the bar's
                 default home is the bottom-right corner, where extra HEIGHT grows towards the
                 screen edge, while the 18px of width this costs is paid once.
                 Declared here rather than built in RebuildCore because it is not part of the
                 Rows panel that gets cleared; RebuildCore refreshes its state instead.
                 Width is FIXED for the same reason Info's is (see above): a control that
                 tracked a workspace name's length would resize, and therefore reposition, a
                 SizeToContent window every time the recency order changed. The destination is
                 named in the tooltip, which costs no layout. -->
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BackButton" Content="↩" Width="18" FontSize="12"
                        Foreground="White" Background="Transparent" BorderThickness="0"
                        Padding="0" VerticalAlignment="Center" Click="OnBackClick"/>
                <TextBlock x:Name="Info" Width="150" FontSize="11" Foreground="White"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
