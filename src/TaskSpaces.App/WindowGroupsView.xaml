<UserControl x:Class="TaskSpaces.App.WindowGroupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Builds the grouped Pinned / workspace / other-desktop rows for ManageWindow's
         Windows tab. Originally extracted (Task 10) to be SHARED with the hover-peek
         SwitcherPanel so the two surfaces could not drift apart; that panel was later
         deleted, since the floating bar and this tab together covered everything it did.
         The extraction is what made deleting it cheap, and this control is left as its own
         UserControl rather than folded back into ManageWindow: it is the one place that
         knows how to render and drag a grouped window list. -->
    <!-- Bind()'s runChildDialog and afterAction hooks are vestigial for the same reason:
         both existed for the panel (its hide-on-deactivate guard, and hiding itself after a
         jump). ManageWindow leaves both at their defaults. They are kept because any future
         transient host would need exactly those two hooks again. -->
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="GroupsHost" MinWidth="300"/>
    </ScrollViewer>
</UserControl>
