<!-- Icon uses an ABSOLUTE pack URI naming the assembly, not the short "/Assets/..." form:
     the short form resolves against Application.ResourceAssembly, which a WPF exe's generated
     Main sets but a test host does not, so it made this window unconstructable under test
     with "Cannot locate resource". Same form in PromptDialog, RehydratePrompt and App.AppIcon. -->
<Window x:Class="TaskSpaces.App.ManageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TaskSpaces.App"
        Title="TaskSpaces — Manage" Width="720" Height="480"
        Icon="pack://application:,,,/TaskSpaces.App;component/Assets/taskspaces.ico">
    <DockPanel>
        <TextBlock x:Name="CompatBanner" DockPanel.Dock="Top" Background="#FFF4CE" Padding="8"
                   Text="⚠ Virtual desktops are unavailable on this Windows build. Workspaces are listed but windows will not be moved."
                   Visibility="Collapsed"/>
        <!-- There is deliberately no "Show floating bar" checkbox. Petre: "show floating bar
             doesn't make sense anymore, it's crucial for the app's design." Correct: once the
             switcher panel and the Windows tab were removed, the bar became the ONLY surface
             that shows windows and jumps to them, so offering to switch it off is like
             offering to switch off the taskbar. It also left a trap, since hiding it removed
             the only way to reach your own windows. The bar is now always on. -->
        <CheckBox x:Name="StartWithWindows" DockPanel.Dock="Bottom" Margin="8"
                  Content="Start TaskSpaces with Windows"
                  Checked="OnStartupToggled" Unchecked="OnStartupToggled"/>
        <TabControl>
            <TabItem Header="Workspaces">
                <DockPanel Margin="8">
                    <!-- Order is not cosmetic, so it is worth saying so where it is edited:
                         this one list drives the floating bar's rows, the switcher panel's
                         groups and which workspace Ctrl+Alt+1..9 selects. Same explanatory
                         style as the Rules tab below. -->
                    <!-- No longer mentions the switcher panel, which has been deleted. -->
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Order sets the floating bar's rows and the Ctrl+Alt+1…9 shortcuts. Select a workspace and use ↑ / ↓ to reorder."/>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBox x:Name="NewWorkspaceName" Width="200"/>
                        <Button Content="Add" Margin="8,0,0,0" Padding="12,2" Click="OnAddWorkspace"/>
                        <Button Content="Rename" Margin="8,0,0,0" Padding="12,2" Click="OnRenameWorkspace"/>
                        <Button Content="Remove" Margin="8,0,0,0" Padding="12,2" Click="OnRemoveWorkspace"/>
                        <Button Content="↑ Up" Margin="16,0,0,0" Padding="12,2" Click="OnMoveWorkspaceUp"/>
                        <Button Content="↓ Down" Margin="4,0,0,0" Padding="12,2" Click="OnMoveWorkspaceDown"/>
                    </StackPanel>
                    <ListBox x:Name="WorkspaceList" DisplayMemberPath="Name"/>
                </DockPanel>
            </TabItem>
            <TabItem Header="Rules">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Rules run top-to-bottom; first match wins. Kinds: ProcessName (exact, e.g. chrome), TitleRegex (.NET regex on the title), BrowserProfile (Chrome/Edge --profile-directory name)."/>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Save rules" Padding="12,2" Click="OnSaveRules"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Workspace rules" FontWeight="Bold"/>
                        <DataGrid x:Name="WorkspaceRulesGrid" AutoGenerateColumns="True" Height="140" CanUserAddRows="True"/>
                        <TextBlock Text="Rename rules" FontWeight="Bold" Margin="0,8,0,0"/>
                        <DataGrid x:Name="RenameRulesGrid" AutoGenerateColumns="True" Height="140" CanUserAddRows="True"/>
                    </StackPanel>
                </DockPanel>
            </TabItem>
            <!-- The "Windows" tab is deliberately gone. Petre: "no need for that window tab",
                 "what's the point of it? we already have floating window manager doing just
                 that". The floating bar covers jumping to a window and dragging windows
                 between workspaces, which is what the tab was mostly used for.
                 What went with it, so the loss is on the record rather than discovered later:
                 ▶ Start (relaunch a workspace's apps), Add app… / Remove from workspace, and
                 the dimmed not-running roster rows. The roster DATA is untouched and still
                 drives placement memory and the post-reboot restore prompt; only its editing
                 UI is gone. If ▶ Start is wanted back it belongs on the Workspaces tab, next
                 to the workspace it starts. -->
        </TabControl>
    </DockPanel>
</Window>
