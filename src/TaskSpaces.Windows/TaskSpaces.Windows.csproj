<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- windows10.0.19041.0 target settled by the Task 1 spike: Slions.VirtualDesktop's
         net8.0-windows lib assets loaded and ran cleanly under a net10 app on build 26200,
         no net8 A/B test or build-override needed. x64 matches the spike's verified config. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TaskSpaces.Core\TaskSpaces.Core.csproj" />
  </ItemGroup>

  <!-- ProcessCommandLine stays internal, being an implementation detail of WindowInfoFactory
       rather than something other code should reach for. It walks undocumented PEB offsets
       though, which is exactly the kind of correctness that wants pinning by a test. Same trade
       the App project makes for the bar's press-routing helpers. -->
  <ItemGroup>
    <InternalsVisibleTo Include="TaskSpaces.Windows.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CSharpFunctionalExtensions" Version="3.7.0" />
    <PackageReference Include="Slions.VirtualDesktop" Version="6.9.2" />
    <PackageReference Include="System.Management" Version="10.0.10" />
    <PackageReference Include="System.Reactive" Version="7.0.0" />
  </ItemGroup>

</Project>
