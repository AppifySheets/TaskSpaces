<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TaskSpaces.Windows\TaskSpaces.Windows.csproj" />
    <!-- TaskSpaces.App is a WinExe, but referencing it is what lets the WPF surfaces
         (FloatingBar, WindowGroupsView) be tested at all: this project is already
         net10.0-windows with UseWPF and already owns StaThread.cs, so it is the natural
         home rather than a fourth project holding one test file. Referencing an exe
         brings in its generated Main, which is harmless — the test host supplies its own
         entry point. -->
    <ProjectReference Include="..\..\src\TaskSpaces.App\TaskSpaces.App.csproj" />
  </ItemGroup>

</Project>