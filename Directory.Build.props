<Project>
  <!-- Shared compiler settings for every project in the solution. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Version and product identity, shared by every project so the exe, its file
       properties and any future NuGet package can never disagree.

       Three version properties exist because Windows and .NET read different ones:
         Version                - the NuGet/semantic version (3 parts, what humans quote)
         AssemblyVersion        - what assembly binding uses; kept at x.0.0.0 so servicing
                                  releases never break a reference
         FileVersion            - what Explorer's Details tab shows (4 parts, must be numeric)
         InformationalVersion   - free-form; the one place a suffix like -beta could go
       Bumping a release means editing VersionPrefix here and nothing else. -->
  <PropertyGroup>
    <VersionPrefix>1.10.1</VersionPrefix>
    <Version>$(VersionPrefix)</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>$(VersionPrefix).0</FileVersion>
    <InformationalVersion>$(VersionPrefix)</InformationalVersion>

    <Product>TaskSpaces</Product>
    <Company>AppifySheets</Company>
    <Authors>Petre Chitashvili</Authors>
    <Copyright>Copyright © AppifySheets 2026</Copyright>
    <Description>Named workspaces for the Windows taskbar, backed by Windows virtual desktops.</Description>
    <RepositoryUrl>https://github.com/AppifySheets/TaskSpaces</RepositoryUrl>
  </PropertyGroup>
</Project>
